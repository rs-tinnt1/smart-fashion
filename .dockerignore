# ===========================================
# .dockerignore - Optimized for minimal build context
# ===========================================

# Git
.git
.gitignore
.gitattributes
.github/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
docs/
*.md
!README.md

# Tests
tests/
.coverage
htmlcov/
pytest.ini

# CI/CD configs
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
compose*.yml
.dockerignore
.docker/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Model files (mounted via volume)
*.pt
*.pth
*.onnx
*.h5
*.pb
models/

# Data directories (mounted via volume)
inputs/
outputs/
uploads/
tmp/
temp/

# Temporary files
*.tmp
*.bak
*.swp

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Development files
Makefile
verify_*.py
CLAUDE.md
AGENTS.md

# Shell scripts (unless needed for entrypoint)
*.sh
