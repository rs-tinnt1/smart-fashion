# ============================================
# Smart Fashion API - Environment Configuration
# ============================================
# Copy this file to .env and customize values as needed
# cp .env.example .env

# ============================================
# Application Settings
# ============================================
APP_VERSION=2.0.0
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
OMP_NUM_THREADS=4
MODEL_PRELOAD=true

# ============================================
# Model Settings
# ============================================
# Primary segment model key in bucket (must upload model to bucket first)
MODEL_SEGMENT=yolo26n-seg.pt
# Fallback model key if the primary model is missing or fails to load
MODEL_SEGMENT_FALLBACK=yolo11n-seg.pt

# ============================================
# MariaDB/MySQL Database
# ============================================
DB_URL=mysql://smartfashion:smartfashion@mariadb:3306/smartfashion
# Optional for managed MySQL providers that require TLS
# DB_SSL=true
# DB_SSL_MODE=required

# ============================================
# Object Storage
# ============================================
S3_ENDPOINT=https://testaccount.r2.cloudflarestorage.com
S3_BUCKET=smartfashion
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
