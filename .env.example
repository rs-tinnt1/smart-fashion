# ============================================
# Smart Fashion API - Environment Configuration
# ============================================
# Copy this file to .env and customize values as needed
# cp .env.example .env

# ============================================
# Application Settings
# ============================================
APP_VERSION=2.0.0
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
OMP_NUM_THREADS=4
MODEL_PRELOAD=true
STATIC_CACHE_CONTROL=

# ============================================
# Model Settings
# ============================================
# Segmentation model key in bucket (must upload model to bucket first)
MODEL_SEGMENT=yolov8n-clothing-detection.pt

# ============================================
# MySQL-Compatible Database
# ============================================
# For local Docker Compose, the default fallback is:
# DB_URL=mysql://smartfashion:smartfashion@mysql:3306/smartfashion
# Example managed provider value:
DB_URL=mysql://smartfashion:smartfashion@mysql-aiven-host:3306/smartfashion?ssl-mode=REQUIRED
# Optional for managed providers that require TLS
# DB_SSL=true
# DB_SSL_MODE=required

# ============================================
# Object Storage
# ============================================
# For local Docker Compose, the default fallback is:
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# Example remote provider value:
S3_ENDPOINT=https://testaccount.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=
S3_BUCKET=smartfashion
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
