# ============================================
# Smart Fashion API - Environment Configuration
# ============================================
# Copy this file to .env and customize values as needed
# cp .env.example .env

# ============================================
# Application Settings
# ============================================
APP_VERSION=2.0.0
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
OMP_NUM_THREADS=4

# ============================================
# Model Settings
# ============================================
# Segment model key in bucket (must upload model to bucket first)
MODEL_SEGMENT=yolo11m-seg.pt

# ============================================
# MariaDB Database
# ============================================
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=smartfashion
DB_USER=smartfashion
DB_PASSWORD=smartfashion
DB_ROOT_PASSWORD=rootpassword

# ============================================
# Object Storage
# ============================================
S3_ENDPOINT=https://testaccount.r2.cloudflarestorage.com
S3_BUCKET=smartfashion
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

