# ============================================
# Smart Fashion API - Environment Configuration
# ============================================
# Copy this file to .env and customize values as needed
# cp .env.example .env

# ============================================
# Application Settings
# ============================================
APP_VERSION=2.0.0
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
OMP_NUM_THREADS=4
MODEL_PRELOAD=true

# ============================================
# Model Settings
# ============================================
# Segmentation model key in bucket (must upload model to bucket first)
MODEL_SEGMENT=yolov8n-clothing-detection.pt

# ============================================
# MariaDB/MySQL Database
# ============================================
DB_URL=mysql://smartfashion:smartfashion@mysql-aiven-host:3306/smartfashion?ssl-mode=REQUIRED
# Optional for managed MySQL providers that require TLS
# DB_SSL=true
# DB_SSL_MODE=required

# ============================================
# Object Storage
# ============================================
S3_ENDPOINT=https://testaccount.r2.cloudflarestorage.com
S3_BUCKET=smartfashion
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
